{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hare & Tortoise",
  "mainBinaryName": "hare-tortoise",
  "version": "1.0.0",
  "identifier": "dev.juandata.haretortoise",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hare & Tortoise",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "shortDescription": "Hare & Tortoise — Digital Edition",
    "longDescription": "Digital adaptation of Hase und Igel (David Parlett, Spiel des Jahres 1979)."
  }
}
